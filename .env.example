# 서버 포트
PORT=3000

# 세션 쿠키 서명 키 (운영에서는 반드시 임의의 긴 문자열로 교체)
SESSION_SECRET=change-me-to-a-long-random-string

# 웹푸시 VAPID 키 — `npm run keys` 로 생성해서 붙여 넣으세요.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 알림 기준 시간대 (IANA time zone)
APP_TIMEZONE=Asia/Seoul

# 매일 미션이 발행되는 시각 (0-23)
MISSION_PUBLISH_HOUR=6

# 오늘의 시 푸시 알림 시각들 (쉼표 구분, 0-23)
POEM_PUSH_HOURS=8,21

# 로그인/가입 시도 제한 (5분당 최대 횟수)
AUTH_RATE_LIMIT_MAX=20

# 초대 코드 입력 시도 제한 (10분당 최대 횟수)
# 코드가 6자리뿐이라 제한이 없으면 남의 방을 찾아낼 수 있습니다.
JOIN_RATE_LIMIT_MAX=10

# ── 구글 로그인 (Phase 2) ──
# Google Cloud Console 에서 OAuth 클라이언트 ID(웹)를 만들어 넣으세요.
# 비워 두면 로그인 화면에 구글 버튼이 뜨지 않고, 아이디+PIN 로그인만 동작합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 개발용 가짜 구글 서버 주소. 자격증명 없이 흐름만 눌러 볼 때 씁니다.
# NODE_ENV=production 에서는 무시됩니다 (docs/구글-로그인-설정.md 참고).
# GOOGLE_FAKE_BASE=http://127.0.0.1:4100

# 스케줄러 사용 여부
ENABLE_SCHEDULER=true

# SQLite 파일 경로
DB_PATH=./data/app.db
