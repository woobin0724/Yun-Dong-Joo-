# 서버 포트
PORT=3000

# 세션 쿠키 서명 키 (운영에서는 반드시 임의의 긴 문자열로 교체)
SESSION_SECRET=change-me-to-a-long-random-string

# 웹푸시 VAPID 키 — `npm run keys` 로 생성해서 붙여 넣으세요.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 알림 기준 시간대 (IANA time zone)
APP_TIMEZONE=Asia/Seoul

# 매일 미션이 발행되는 시각 (0-23)
MISSION_PUBLISH_HOUR=6

# 오늘의 시 푸시 알림 시각들 (쉼표 구분, 0-23)
POEM_PUSH_HOURS=8,21

# 로그인/가입 시도 제한 (5분당 최대 횟수)
AUTH_RATE_LIMIT_MAX=20

# 스케줄러 사용 여부
ENABLE_SCHEDULER=true

# SQLite 파일 경로
DB_PATH=./data/app.db
